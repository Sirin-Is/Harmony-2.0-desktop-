{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Harmony",
  "version": "1.5.0",
  "identifier": "com.harmony.crm",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Harmony",
        "width": 1440,
        "height": 900,
        "maximized": true,
        "minWidth": 1024,
        "minHeight": 700,
        "backgroundColor": "#f6f8fb"
      }
    ],
    "security": {
    "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://ldicshjvdxdfilucflkd.supabase.co"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
